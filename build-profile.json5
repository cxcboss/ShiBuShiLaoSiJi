{
  "app": {
    "signingConfigs": [
      // 签名配置属于本地隐私信息，不入库。
      // 请在 DevEco Studio 中打开 File > Project Structure > Signing Configs，
      // 勾选 "Automatically generate signature" 自动生成本地签名配置。
    ],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "6.1.0(23)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
